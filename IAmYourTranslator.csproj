<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>IAmYourTranslator</AssemblyName>
    <Description>Translation and asset replacement mod for I Am Your Beast</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\I Am Your Beast</GameDir>
    <OpenModFolderAfterBuild Condition="'$(OpenModFolderAfterBuild)' == ''">true</OpenModFolderAfterBuild>
  </PropertyGroup>

  <Target Name="ValidateGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == ''"
           Text="GameDir is not set. Create a local GameDir.props file or pass /p:GameDir=\&quot;C:\Path\To\I Am Your Beast\&quot; to MSBuild." />
    <Error Condition="!Exists('$(GameDir)\I Am Your Beast_Data\Managed\Assembly-CSharp.dll')"
           Text="GameDir path '$(GameDir)' is invalid or does not contain the game files. Update GameDir.props or pass /p:GameDir=\&quot;...\&quot;." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AudioTextSynchronizer">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\AudioTextSynchronizer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference> 
    <Reference Include="UnityEngine.UnityWebRequestWWWModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.UnityWebRequestWWWModule.dll</HintPath>
      <Private>false</Private>
    </Reference> 
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference> 
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference> 
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameDir)\I Am Your Beast_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <Target Name="OpenModFolderAfterBuild" AfterTargets="Build" Condition="'$(OpenModFolderAfterBuild)' == 'true'">
    <Exec Command="cmd /c start &quot;&quot; &quot;$(TargetDir)&quot;" ContinueOnError="true" />
  </Target>

  <Import Project="GameDir.props" Condition="Exists('GameDir.props')" />
</Project>
